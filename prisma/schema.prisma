// @canonical-root File-11: 11_01_MAIN_BASE_SCHEMA
// @child-ext      NONE
// @tier           Tier-1
// @domain         Domain-00 to Domain-07
// @zero-loss-rule Invariant validated against master specification

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// DOMAIN-00: MASTER GOVERNANCE & SAFETY
// ==========================================

model D00_SystemConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  key                 String   @unique
  value               String
  is_encrypted        Boolean  @default(false)
  updated_by          String   @default("SYSTEM")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model D00_OwnerAuditLog {
  id                  String   @id @default(uuid()) @db.Uuid
  action              String
  actor_id            String
  target_domain       String
  payload_hash        String
  details             String?
  timestamp           DateTime @default(now())
}

model D00_AiGovernanceDirective {
  id                  String   @id @default(uuid()) @db.Uuid
  directive_code      String   @unique
  category            String
  rule_content        String
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

// ==========================================
// DOMAIN-01: TRADING & BROKER INTEGRATION
// ==========================================

model D01_TradingSignal {
  id                  String   @id @default(uuid()) @db.Uuid
  ticker              String
  action              String
  entry_price         Decimal  @db.Decimal(18, 8)
  stop_loss           Decimal  @db.Decimal(18, 8)
  target_1            Decimal  @db.Decimal(18, 8)
  target_2            Decimal? @db.Decimal(18, 8)
  timeframe           String
  idempotency_key     String   @unique
  status              String   @default("PENDING")
  created_at          DateTime @default(now())
}

model D01_TradeOrder {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  broker_name         String
  symbol              String
  side                String
  quantity            Decimal  @db.Decimal(18, 8)
  price               Decimal  @db.Decimal(18, 8)
  status              String   @default("SUBMITTED")
  broker_order_id     String?  @unique
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model D01_BrokerAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @unique
  broker_type         String
  client_id           String
  encrypted_token     String
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model D01_Position {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  symbol              String
  broker_name         String
  quantity            Decimal  @db.Decimal(18, 8)
  avg_entry_price     Decimal  @db.Decimal(18, 8)
  current_price       Decimal  @db.Decimal(18, 8)
  unrealized_pnl      Decimal  @db.Decimal(18, 8)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

// ==========================================
// DOMAIN-02: LEGAL & COMPLIANCE
// ==========================================

model D02_UserConsent {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @unique
  consent_version     String
  has_accepted_terms  Boolean  @default(false)
  has_accepted_risk   Boolean  @default(false)
  ip_address          String?
  timestamp           DateTime @default(now())
}

model D02_DisclaimerAudit {
  id                  String   @id @default(uuid()) @db.Uuid
  message_id          String
  chat_id             String
  disclaimer_hash     String
  timestamp           DateTime @default(now())
}

// ==========================================
// DOMAIN-03: BILLING & PAYMENT GATEWAYS
// ==========================================

model D03_SubscriptionPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  plan_code           String   @unique
  name                String
  price_fiat          Decimal  @db.Decimal(12, 2)
  validity_days       Int
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
}

model D03_UserSubscription {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  plan_id             String   @db.Uuid
  start_date          DateTime @default(now())
  expiry_date         DateTime
  is_active           Boolean  @default(true)
}

model D03_PaymentInvoice {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  amount              Decimal  @db.Decimal(12, 2)
  currency            String   @default("INR")
  gateway             String
  transaction_id      String   @unique
  status              String   @default("INITIATED")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

// ==========================================
// DOMAIN-04: TELEGRAM UX & SESSIONS
// ==========================================

model D04_TelegramUser {
  id                  String   @id @default(uuid()) @db.Uuid
  telegram_id         BigInt   @unique
  username            String?
  first_name          String?
  is_registered       Boolean  @default(false)
  current_role        String   @default("MEMBER")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model D04_UserSessionFsm {
  id                  String   @id @default(uuid()) @db.Uuid
  telegram_id         BigInt   @unique
  current_scene       String   @default("IDLE")
  session_data        Json     @default("{}")
  updated_at          DateTime @updatedAt
}

model D04_SupportTicket {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  subject             String
  status              String   @default("OPEN")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

// ==========================================
// DOMAIN-05: CREATOR STUDIO & BROADCAST
// ==========================================

model D05_CreatorContent {
  id                  String   @id @default(uuid()) @db.Uuid
  author_id           String
  content_type        String
  payload_url         String
  status              String   @default("DRAFT")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model D05_BroadcastQueue {
  id                  String   @id @default(uuid()) @db.Uuid
  content_id          String   @db.Uuid
  target_audience     String
  delivery_status     String   @default("QUEUED")
  scheduled_at        DateTime
  created_at          DateTime @default(now())
}

// ==========================================
// DOMAIN-06: RETENTION & RECURRING LOYALTY
// ==========================================

model D06_UserStreak {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String   @unique
  current_streak      Int      @default(1)
  longest_streak      Int      @default(1)
  last_activity_date  DateTime @default(now())
}

model D06_RetentionMetric {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  engagement_score    Decimal  @default(0.00) @db.Decimal(5, 2)
  recorded_at         DateTime @default(now())
}

model D06_ScheduledTask {
  id                  String   @id @default(uuid()) @db.Uuid
  task_name           String
  cron_expression     String
  is_running          Boolean  @default(false)
  last_run_at         DateTime?
}

// ==========================================
// DOMAIN-07: AFFILIATE NETWORK & PAYOUTS
// ==========================================

model D07_AffiliateProfile {
  id                     String                 @id @default(uuid()) @db.Uuid
  user_id                String                 @unique
  sponsor_id             String?                @db.Uuid
  sponsor                D07_AffiliateProfile?  @relation("AffiliateHierarchy", fields: [sponsor_id], references: [id], onDelete: SetNull)
  downlines              D07_AffiliateProfile[] @relation("AffiliateHierarchy")
  tree_path              String                 @default("/")
  tree_depth             Int                    @default(0)
  status                 String                 @default("ACTIVE")
  direct_referrals_count Int                    @default(0)
  total_downline_count   Int                    @default(0)
  total_team_volume      Decimal                @default(0.00) @db.Decimal(12, 2)
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
}

model D07_AffiliateLedger {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  amount              Decimal  @db.Decimal(12, 2)
  entry_type          String   // CREDIT | DEBIT
  source_event        String
  idempotency_key     String   @unique
  created_at          DateTime @default(now())
}

model D07_LockinSchedule {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  amount              Decimal  @db.Decimal(12, 2)
  locked_at           DateTime @default(now())
  unlock_at           DateTime
  status              String   @default("LOCKED")
}

model D07_DiversificationReward {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  multiplier          Decimal  @default(1.00) @db.Decimal(4, 2)
  reward_points       Int      @default(0)
  awarded_at          DateTime @default(now())
}

model D07_PayoutRequest {
  id                  String   @id @default(uuid()) @db.Uuid
  user_id             String
  amount              Decimal  @db.Decimal(12, 2)
  payout_mode         String   // UPI | USDT
  destination_address String
  status              String   @default("REQUESTED")
  requested_at        DateTime @default(now())
  processed_at        DateTime?
}

model D07_PayoutAuditTrail {
  id                  String   @id @default(uuid()) @db.Uuid
  payout_request_id   String   @db.Uuid
  reviewer_id         String
  status_change       String
  notes               String?
  timestamp           DateTime @default(now())
}
// =============================================================================
// PHASE 2: HYPERLOCAL SECTORS, MERCHANT KYB & GIG LOGISTICS (MODELS 23 TO 26)
// =============================================================================

// Model 23: D04_SectorRegistry (Universal 30-Sector Registry & Convenience Fee Corridor)
model D04_SectorRegistry {
  id                    String                   @id @default(uuid()) @db.Uuid
  sector_code           String                   @unique @db.VarChar(50)
  name                  String                   @db.VarChar(100)
  category              String                   @default("RETAIL") @db.VarChar(50)
  p_floor_paise         Int                      @default(200)
  p_ceiling_paise       Int                      @default(1000)
  convenience_fee_paise Int                      @default(300)
  is_active             Boolean                  @default(true)
  is_owner_locked       Boolean                  @default(true)
  created_at            DateTime                 @default(now()) @db.Timestamptz
  updated_at            DateTime                 @updatedAt @db.Timestamptz

  merchants             D04_MerchantProfile[]
  fulfilment_templates  D04_FulfilmentTemplate[]
  orders                D08_HyperlocalOrder[]

  @@map("d04_sector_registry")
}

// Model 24: D04_MerchantProfile (0% Commission, Trade KYB & License Expiry Sentinel)
model D04_MerchantProfile {
  id                    String              @id @default(uuid()) @db.Uuid
  user_id               String              @db.Uuid
  sector_id             String              @db.Uuid
  business_name         String              @db.VarChar(150)
  trade_license_no      String?             @db.VarChar(100)
  gstin                 String?             @db.VarChar(30)
  fssai_no              String?             @db.VarChar(30)
  kyb_status            String              @default("PENDING") @db.VarChar(30)
  license_expiry_date   DateTime?           @db.Timestamptz
  product_margin_pct    Decimal             @default(0.00) @db.Decimal(5, 2)
  is_sponsored_fee      Boolean             @default(false)
  is_active             Boolean             @default(true)
  created_at            DateTime            @default(now()) @db.Timestamptz
  updated_at            DateTime            @updatedAt @db.Timestamptz

  sector                D04_SectorRegistry  @relation(fields: [sector_id], references: [id], onDelete: Restrict)
  orders                D08_HyperlocalOrder[]

  @@index([user_id])
  @@index([sector_id])
  @@index([kyb_status])
  @@map("d04_merchant_profiles")
}

// Model 25: D04_FulfilmentTemplate (SLA Dispatch Rules, Gender Shield & OTP Gate)
model D04_FulfilmentTemplate {
  id                         String              @id @default(uuid()) @db.Uuid
  template_code              String              @unique @db.VarChar(50)
  sector_id                  String              @db.Uuid
  name                       String              @db.VarChar(100)
  sla_delivery_minutes       Int                 @default(30)
  requires_otp               Boolean             @default(true)
  requires_huid_verification Boolean             @default(false)
  requires_gender_shield     Boolean             @default(false)
  base_runner_payout_paise   Int                 @default(2500)
  weather_surcharge_paise    Int                 @default(0)
  is_active                  Boolean             @default(true)
  created_at                 DateTime            @default(now()) @db.Timestamptz
  updated_at                 DateTime            @updatedAt @db.Timestamptz

  sector                     D04_SectorRegistry  @relation(fields: [sector_id], references: [id], onDelete: Cascade)
  orders                     D08_HyperlocalOrder[]

  @@index([sector_id])
  @@map("d04_fulfilment_templates")
}

// Model 26: D08_HyperlocalOrder (1km Radius Dispatch, OTP Escrow & Atomic Settlement)
model D08_HyperlocalOrder {
  id                       String                 @id @default(uuid()) @db.Uuid
  order_number             String                 @unique @db.VarChar(64)
  sector_id                String                 @db.Uuid
  merchant_id              String                 @db.Uuid
  customer_id              String                 @db.Uuid
  runner_id                String?                @db.Uuid
  template_id              String                 @db.Uuid
  order_gross_paise        BigInt
  convenience_fee_paise    Int                    @default(300)
  runner_payout_paise      Int                    @default(2500)
  otp_code_hash            String                 @db.VarChar(64)
  status                   String                 @default("INITIATED") @db.VarChar(30)
  escrow_cleared           Boolean                @default(false)
  delivery_distance_meters Int                    @default(1000)
  created_at               DateTime               @default(now()) @db.Timestamptz
  updated_at               DateTime               @updatedAt @db.Timestamptz

  sector                   D04_SectorRegistry     @relation(fields: [sector_id], references: [id], onDelete: Restrict)
  merchant                 D04_MerchantProfile    @relation(fields: [merchant_id], references: [id], onDelete: Restrict)
  template                 D04_FulfilmentTemplate @relation(fields: [template_id], references: [id], onDelete: Restrict)

  @@index([merchant_id])
  @@index([customer_id])
  @@index([runner_id])
  @@index([status])
  @@map("d08_hyperlocal_orders")
}
// Phase 1.2: System Audit Incident Entity
model SystemAuditIncident {
  id             String    @id @default(cuid())
  traceId        String    @map("trace_id")
  subsystem      String
  severity       String    // YELLOW | RED
  errorSignature String    @map("error_signature")
  cause          String?
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([severity])
  @@index([createdAt])
  @@map("system_audit_incidents")
}

